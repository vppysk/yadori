# Copy to .env.local. 日本語の説明は CLAUDE.md を参照

# Display language: en (English demo) / ja (Japanese, default). Also sets the language of AI output and fixed messages
NEXT_PUBLIC_APP_LOCALE=en

# mock: no LLM cost (AI SDK mock models, default) / nebius: Nebius Token Factory (required for the real demo)
LLM_MODE=nebius
NEBIUS_API_KEY=
# Defaults (src/lib/llm/models.ts)
# LLM_MODEL_SMALL=nvidia/Nemotron-3_5-Lightning
# LLM_MODEL_MEDIUM=nvidia/nemotron-3-super-120b-a12b
# LLM_MODEL_LARGE=nvidia/Nemotron-3-Ultra-550b-a55b

# Postgres (server-side only). Local Supabase started with `npm run db:start`:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# For a cloud Supabase project on an IPv4-only host, use the Session pooler connection string

# Mock property management system (MCP server inside this app). The token is any long random string
PMS_MCP_URL=http://localhost:3000/api/mcp/pms
PMS_MCP_TOKEN=change-me-to-a-long-random-string

# Protects the scheduled endpoints (/api/cron/*). If set, a Bearer token is required
CRON_SECRET=

# Token for the work-data export MCP server (/api/mcp/work-events)
EXPORT_MCP_TOKEN=change-me-too

# Fetching registered web pages (Tavily Extract, https://app.tavily.com). Optional; leave empty to disable
TAVILY_API_KEY=
