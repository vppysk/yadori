# mock: LLM費用なしのモック（既定） / nebius: Nebius Token Factory
LLM_MODE=mock
NEBIUS_API_KEY=
# 省略時の既定値（src/lib/llm/models.ts）
# LLM_MODEL_SMALL=nvidia/Nemotron-3_5-Lightning
# LLM_MODEL_MEDIUM=nvidia/nemotron-3-super-120b-a12b
# LLM_MODEL_LARGE=nvidia/Nemotron-3-Ultra-550b-a55b

# Supabase（サーバー側のみで使用。publishable/anon key は不要）
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# ホスティング先がIPv4のみの場合は Session pooler の接続文字列にする
DATABASE_URL=
